# /etc/default/hosted-portal-8866
# Production environment for hosted portal on 10.17.7.88:8866

HOSTED_PORTAL_ENV=production
HOSTED_PORTAL_HOST=0.0.0.0
HOSTED_PORTAL_PORT=8866
HOSTED_PORTAL_BASE_URL=http://10.17.7.88:8866

# Keep SERVER_NAME relaxed unless you explicitly want host enforcement.
HOSTED_PORTAL_ENFORCE_SERVER_NAME=false

# Core storage roots (persistent)
HOSTED_PORTAL_RELEASE_ROOT=/home/pgupta11/Projects/STAT6_PPI/PPI_program_writing/R_group_mapping/advanced_problems/hosting_docking_portal/releases
HOSTED_PORTAL_UPLOAD_ROOT=/var/lib/hosted-docking-portal/uploads
HOSTED_PORTAL_JOB_ROOT=/var/lib/hosted-docking-portal/jobs
HOSTED_PORTAL_CACHE_DIR=/var/cache/hosted-docking-portal

# Persistent vote DB (do not use repo tmp for production)
HOSTED_PORTAL_VOTE_DB_PATH=/var/lib/hosted-docking-portal/votes/votes.sqlite3

# Logging
HOSTED_PORTAL_LOG_DIR=/var/log/hosted-docking-portal
HOSTED_PORTAL_LOG_LEVEL=INFO
HOSTED_PORTAL_LOG_MAX_BYTES=20971520
HOSTED_PORTAL_LOG_BACKUP_COUNT=14

# Gunicorn runtime (safe with current in-process job scheduler)
HOSTED_PORTAL_GUNICORN_BIND=0.0.0.0:8866
HOSTED_PORTAL_GUNICORN_WORKERS=1
HOSTED_PORTAL_GUNICORN_THREADS=8
HOSTED_PORTAL_GUNICORN_WORKER_CLASS=gthread
HOSTED_PORTAL_GUNICORN_TIMEOUT=120
HOSTED_PORTAL_GUNICORN_GRACEFUL_TIMEOUT=30
HOSTED_PORTAL_GUNICORN_KEEPALIVE=5
HOSTED_PORTAL_GUNICORN_MAX_REQUESTS=500
HOSTED_PORTAL_GUNICORN_MAX_REQUESTS_JITTER=100
HOSTED_PORTAL_GUNICORN_WORKER_TMP_DIR=/dev/shm

# Job execution and UI polling
HOSTED_PORTAL_JOB_MAX_WORKERS=2
HOSTED_PORTAL_PIPELINE_DEFAULT_N_WORKERS=8
HOSTED_PORTAL_PIPELINE_MAX_N_WORKERS=32
HOSTED_PORTAL_JOB_POLL_SECONDS=2
HOSTED_PORTAL_VOTE_POLL_SECONDS=5
HOSTED_PORTAL_JOB_HEARTBEAT_STALE_SECONDS=900

# Startup behavior
HOSTED_PORTAL_STARTUP_STRICT=false

# Upload limits
HOSTED_PORTAL_MAX_UPLOAD_MB=512

# Retention / cleanup controls
HOSTED_PORTAL_RETENTION_UPLOAD_DAYS=30
HOSTED_PORTAL_RETENTION_JOB_WORKSPACE_DAYS=30
HOSTED_PORTAL_RETENTION_FAILED_JOB_DAYS=60
HOSTED_PORTAL_ADMIN_CLEANUP_ENABLED=false
HOSTED_PORTAL_ALLOW_RELEASE_DELETE=true

# Optional: set for privileged admin endpoints
HOSTED_PORTAL_ADMIN_TOKEN=

# Optional but recommended for security
# HOSTED_PORTAL_SECRET_KEY=replace-with-long-random-secret
